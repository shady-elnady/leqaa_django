#!/bin/bash

# brew services start mongodb-community@6.0


python manage.py cleanproject_seeds

find . -path "*/migrations/*.py" -not -path "./venv/*"  -not -name "__init__.py" -print -delete
find . | grep -E "(/__pycache__$|\.pyc$|\.pyo$)" | xargs rm -rf

python manage.py makemigrations
python manage.py migrate
python manage.py collectstatic

python manage.py languages_seeds
python manage.py currencies_seeds
python manage.py address_seeds
python manage.py locales_seeds
python manage.py categories_seeds
python manage.py organizations_seeds
python manage.py users_seeds
python manage.py events_seeds
python manage.py reservations_seeds
python manage.py payments_seeds
python manage.py advertisements_seeds
python manage.py notifications_seeds

DJANGO_SUPERUSER_PASSWORD=12345678 ./manage.py createsuperuser \
    --no-input \
    --username=Shady \
    --email=super@s.com

python manage.py runserver
